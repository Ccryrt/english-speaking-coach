#!/bin/sh
# Shared English/Japanese entry. Requires the verified bundled runtime.
set -eu
coach_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
coach_version=$(tr -d '\r\n' < "$coach_root/runtime-version.txt")
case "$coach_version" in v[0-9]*.[0-9]*.[0-9]*) ;; *) echo 'Invalid pinned runtime version' >&2; exit 1;; esac
case "$(uname -s)" in Darwin) coach_os=darwin;; Linux) coach_os=linux;; *) echo 'Use scripts/coach.ps1 on Windows.' >&2; exit 1;; esac
case "$(uname -m)" in arm64|aarch64) coach_arch=arm64;; x86_64|amd64) coach_arch=amd64;; *) echo 'Unsupported CPU architecture' >&2; exit 1;; esac
coach_name="english-coach_${coach_version}_${coach_os}_${coach_arch}"
coach_binary="$coach_root/bin/$coach_name"
coach_receipt="$coach_binary.sha256"
coach_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi
}
# Copies may lose executable bits. Repair only bytes verified at installation;
# legacy caches without a receipt are downloaded and checked if not executable.
[ -f "$coach_receipt" ] || { echo "Runtime receipt missing; rebuild/reinstall the plugin." >&2; exit 1; }
if [ -f "$coach_binary" ]; then
  coach_cached_expected=$(tr -d '\r\n' < "$coach_receipt")
  [ "$(coach_sha256 "$coach_binary")" = "$coach_cached_expected" ] || { echo 'Cached runtime checksum mismatch; nothing executed. Agent must restore the verified pinned release.' >&2; exit 1; }
  [ -x "$coach_binary" ] || chmod 755 "$coach_binary"
fi
if [ ! -x "$coach_binary" ]; then
  echo 'Combined runtime missing. Rebuild/reinstall this English + Japanese plugin; the upstream English-only release cannot replace it.' >&2
  exit 1
fi
export ENGLISH_COACH_SKILL_ROOT="$coach_root"
exec "$coach_binary" "$@"
