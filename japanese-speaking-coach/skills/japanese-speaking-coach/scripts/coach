#!/bin/sh
set -eu
coach_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
coach_binary="$coach_root/bin/japanese-coach"
[ -f "$coach_binary" ] && [ -f "$coach_binary.sha256" ] || { echo 'Japanese runtime missing. Build this plugin with scripts/build.py; do not download the English runtime.' >&2; exit 1; }
if command -v sha256sum >/dev/null 2>&1; then
  coach_hash=$(sha256sum "$coach_binary" | awk '{print $1}')
else
  coach_hash=$(shasum -a 256 "$coach_binary" | awk '{print $1}')
fi
[ "$coach_hash" = "$(cat "$coach_binary.sha256")" ] || { echo 'Japanese runtime checksum mismatch; rebuild the Japanese plugin.' >&2; exit 1; }
[ -x "$coach_binary" ] || chmod 755 "$coach_binary"
export JAPANESE_COACH_SKILL_ROOT="$coach_root"
exec "$coach_binary" "$@"
